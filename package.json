{
	"name": "ses-mail-worker",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"lint": "npx @biomejs/biome check packages/dashboard/src packages/worker/src deploy/index.ts || (npx @biomejs/biome check --write packages/dashboard/src packages/worker/src deploy/index.ts; exit 1)",
		"build-dashboard": "pnpm run --filter email-explorer-dashboard build",
		"build-worker": "pnpm run --filter email-explorer build",
		"test": "pnpm run --filter email-explorer test",
		"build": "pnpm build-dashboard && pnpm build-worker"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.0",
		"@changesets/changelog-github": "^0.6.0",
		"@changesets/cli": "^2.30.0",
		"wrangler": "^4.45.0"
	}
}
